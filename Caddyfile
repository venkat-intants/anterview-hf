# ---------------------------------------------------------------------------
# Caddyfile — Intants AI Voice Interview Platform (production, single-VM)
#
# Caddy is the ONLY publicly reachable process (ports 80 + 443).
# All four FastAPI services are on the internal Docker network only.
#
# REQUIRED env var (set in deploy.env or the host environment):
#   PUBLIC_API_DOMAIN   e.g. api.yourdomain.com
#
# Caddy obtains a TLS certificate automatically via ACME (Let's Encrypt).
# The domain MUST resolve to this VM's public IP before you start the stack,
# otherwise ACME will fail and Caddy will refuse to start.
#
# ROUTING CONTRACT (critical — do not "simplify" to /api/v1/*):
#   The React frontend (Vercel) and every FastAPI service speak BARE paths
#   (/auth, /hr, /api/sessions, /admin/overview, ...). The frontend's four
#   VITE_*_API_URL vars all point at THIS domain in production; Caddy is what
#   fan-outs each bare path to the right upstream. So the matchers below MUST
#   mirror the services' real routes. Three prefixes are shared by two services
#   and are disambiguated by Caddy's longest-path-wins rule (more specific
#   `handle` matchers are evaluated first, regardless of order here):
#     /admin/* → admin_ops for analytics/interviews/overview/status/system,
#                data_gateway for everything else (companies, hr-managers, ...)
#     /api/*   → feedback_billing for /api/scorecards*, interview_core for the rest
#     /users/* → admin_ops for /users/*/dpdp/*, data_gateway for the rest
# ---------------------------------------------------------------------------
{
	# Caddy is the edge today (only 80/443 are open). If a CDN (Cloudflare) is
	# ever placed in front, its egress ranges must be added here so the real
	# client IP is preserved for rate-limiting + the DPDP consent IP hash.
	servers {
		trusted_proxies static private_ranges
	}
}

{$PUBLIC_API_DOMAIN} {
	# ==================================================================
	# Blocked paths — evaluated first because they are the most specific.
	# /internal/* is service-to-service ONLY (Gemini scoring/embeddings);
	# /metrics leaks user/session-id cardinality labels. Neither may ever
	# be reachable from the public internet.
	# ==================================================================
	handle /internal/* {
		respond "Forbidden" 403
	}
	handle /metrics* {
		respond "Forbidden" 403
	}
	# /test-hooks/* runs data_gateway's background passes on demand for the
	# local browser tests. The router is only mounted when TEST_HOOKS_ENABLED,
	# and config refuses that flag outside a local env — this is the second,
	# independent lock: even a mis-set env cannot make it reachable from
	# outside. 404, not 403: a deployment has no test surface to admit to.
	handle /test-hooks* {
		respond "Not Found" 404
	}

	# ==================================================================
	# admin_ops  :8004  — analytics + ops dashboard + DPDP erasure.
	# These sub-paths of /admin and /users are MORE specific than the
	# data_gateway /admin/* and /users/* blocks below, so Caddy matches
	# them first (longest-path-wins).
	# ==================================================================
	handle /admin/analytics/* {
		reverse_proxy admin_ops:8004
	}
	handle /admin/interviews* {
		reverse_proxy admin_ops:8004
	}
	handle /admin/overview* {
		reverse_proxy admin_ops:8004
	}
	handle /admin/status* {
		reverse_proxy admin_ops:8004
	}
	handle /admin/system/* {
		reverse_proxy admin_ops:8004
	}
	handle /users/*/dpdp/* {
		reverse_proxy admin_ops:8004
	}

	# ==================================================================
	# feedback_billing  :8003  — scoring, PDF scorecards.
	# /api/scorecards* is more specific than interview_core's /api/* below.
	# ==================================================================
	handle /api/scorecards* {
		reverse_proxy feedback_billing:8003
	}

	# ==================================================================
	# interview_core  :8001  — LiveKit / real-time interview API.
	# Serves /api/me, /api/avatars, /api/sessions*, /api/rooms/*.
	# ==================================================================
	handle /api/* {
		reverse_proxy interview_core:8001
	}
	handle /ws/* {
		reverse_proxy interview_core:8001
	}

	# ==================================================================
	# data_gateway  :8002  — auth, users, ATS, exams, consent (catch-all
	# for the remaining bare prefixes + the generic /admin and /users).
	# ==================================================================
	handle /auth/* {
		# Sized from the handler's own limit, not guessed. A cap here is the ONLY
		# control that works: fastapi 0.133 reads the whole request body before it
		# solves a route's dependencies, so the in-handler size check and the
		# rate_limit both run AFTER an arbitrarily large body has been buffered —
		# a multipart file part lands in a SpooledTemporaryFile that rolls onto
		# this container's disk. Pre-auth, pre-limit, one request (VAPT 2026-10-05).
		request_body {
			max_size 256KB
		}
		reverse_proxy data_gateway:8002
	}
	# /apply* and /careers* are the PUBLIC candidate surface (PH3): the careers
	# board, the application form, the activation links and all six Save & Resume
	# draft routes. They were missing from both Caddyfiles from the day the
	# routers landed, so every one of them bypassed data_gateway entirely, answering
	# the catch-all 404 instead.
	#
	# Browser NAVIGATION to /apply/:id, /apply/draft and /careers/:slug is still
	# the SPA's — the @spa_nav rewrite above runs before every handle block, which
	# is the same mechanism that lets /hr/*, /jobs* and /exam* be both a React
	# route and an API prefix. Only XHR (Accept: */*) reaches the backend.
	handle /apply* {
		# ANONYMOUS, AND THE ONLY UPLOAD ON THIS PREFIX IS A 5 MB CV.
		#
		# Sized from the handler's own limit, not guessed. A cap here is the ONLY
		# control that works: fastapi 0.133 reads the whole request body before it
		# solves a route's dependencies, so the in-handler size check and the
		# rate_limit both run AFTER an arbitrarily large body has been buffered —
		# a multipart file part lands in a SpooledTemporaryFile that rolls onto
		# this container's disk. Pre-auth, pre-limit, one request (VAPT 2026-10-05).
		#
		# `_MAX_RESUME_BYTES` is therefore a bound on what the handler READS, not
		# on what the service RECEIVES. docs/ACCEPTED-RISKS.md AR-10 residue 3
		# recorded that the rate limits "never reach the upload at all"; this is
		# the bound that does.
		#
		# 6MB, not the 8MB PH3-B4b first put here: 5 MB of CV plus multipart
		# overhead, with the JSON answers field and the form text accounted for
		# rather than given room to spare. The VAPT number is the one kept — it
		# is derived from the same handler limit and is tighter.
		request_body {
			max_size 6MB
		}
		reverse_proxy data_gateway:8002
	}
	handle /careers* {
		# Sized from the handler's own limit, not guessed. A cap here is the ONLY
		# control that works: fastapi 0.133 reads the whole request body before it
		# solves a route's dependencies, so the in-handler size check and the
		# rate_limit both run AFTER an arbitrarily large body has been buffered —
		# a multipart file part lands in a SpooledTemporaryFile that rolls onto
		# this container's disk. Pre-auth, pre-limit, one request (VAPT 2026-10-05).
		request_body {
			max_size 256KB
		}
		reverse_proxy data_gateway:8002
	}
	handle /consent* {
		reverse_proxy data_gateway:8002
	}
	handle /exam* {
		# Sized from the handler's own limit, not guessed. A cap here is the ONLY
		# control that works: fastapi 0.133 reads the whole request body before it
		# solves a route's dependencies, so the in-handler size check and the
		# rate_limit both run AFTER an arbitrarily large body has been buffered —
		# a multipart file part lands in a SpooledTemporaryFile that rolls onto
		# this container's disk. Pre-auth, pre-limit, one request (VAPT 2026-10-05).
		request_body {
			max_size 2MB
		}
		reverse_proxy data_gateway:8002
	}
	handle /agent/* {
		reverse_proxy data_gateway:8002
	}
	# /interviewer/* — PH4-A1's interviewer console API. Browser navigation to
	# the /interviewer SPA route is still the SPA's via @spa_nav above.
	handle /interviewer/* {
		# JSON only — scorecards, notes (20 000 characters at most) — and no
		# uploads, so a megabyte is generous. Set here rather than on /hr/*,
		# which carries bulk CV uploads of up to 250 MB.
		request_body {
			max_size 1MB
		}
		reverse_proxy data_gateway:8002
	}
	# /hr/rounds/*/task/materials* — PH4-D4: HR's reference-material upload for
	# a job-simulation/portfolio round. More specific than /hr/* below (which
	# must stay uncapped for bulk CV ingestion, up to 250 MB), so Caddy's
	# longest-path-wins picks this narrower block first. docs/ACCEPTED-RISKS.md
	# AR-6 says this upload is "enforced at the edge"; before this block it was
	# not — L8, security review PH4-D4 wave 5.
	handle /hr/rounds/*/task/materials* {
		request_body {
			max_size 11MB
		}
		reverse_proxy data_gateway:8002
	}
	# /hr/applicants/bulk — the ONE route behind /hr/* that is meant to carry a
	# large body: up to _MAX_BULK_FILES (500) resumes and _MAX_BULK_TOTAL_BYTES
	# (250 MB) in a single multipart request, both enforced in the handler. A
	# tighter prefix cap would 413 a legitimate batch at the edge, which is why
	# this needs its own block rather than a bigger number on /hr/* (review
	# 2026-10-06). Longest-path-wins puts it ahead of /hr/* — see the header.
	handle /hr/applicants/bulk* {
		request_body {
			max_size 260MB
		}
		reverse_proxy data_gateway:8002
	}
	handle /hr/* {
		# Defence in depth only — it does NOT bound the parse (a kilobyte of
		# crafted PDF or xlsx is the real attack, see app/pdf_text.py). What it
		# does bound is the body FastAPI buffers before any handler runs.
		#
		# 12MB is the largest single-document limit behind this prefix: the HR
		# library corpus and preboarding documents are 10 MB
		# (corpus_document_max_bytes, preboarding_document_max_bytes), the exam
		# and question-bank importers 2 MB, a single resume 5 MB. The two routes
		# that legitimately exceed it have their own blocks above —
		# /hr/rounds/*/task/materials* and /hr/applicants/bulk*.
		request_body {
			max_size 12MB
		}
		reverse_proxy data_gateway:8002
	}
	handle /interview-invite* {
		# Sized from the handler's own limit, not guessed. A cap here is the ONLY
		# control that works: fastapi 0.133 reads the whole request body before it
		# solves a route's dependencies, so the in-handler size check and the
		# rate_limit both run AFTER an arbitrarily large body has been buffered —
		# a multipart file part lands in a SpooledTemporaryFile that rolls onto
		# this container's disk. Pre-auth, pre-limit, one request (VAPT 2026-10-05).
		request_body {
			max_size 256KB
		}
		reverse_proxy data_gateway:8002
	}
	# /offer* — PH4-A3/A4: the candidate's offer and preboarding documents,
	# reached by a magic link (X-Offer-Token). Uploads are one document at a
	# time, 10 MB at most.
	handle /offer* {
		request_body {
			max_size 11MB
		}
		reverse_proxy data_gateway:8002
	}
	# /task* — PH4-D4: a job-simulation or portfolio task, reached by a magic
	# link (X-Task-Token). Artifacts are uploaded one at a time, 10 MB at most.
	handle /task* {
		request_body {
			max_size 11MB
		}
		reverse_proxy data_gateway:8002
	}
	handle /jobs* {
		# Defence in depth only — it does NOT bound the parse (a kilobyte of
		# crafted PDF is the real attack, see app/pdf_text.py). What it does bound
		# is the body FastAPI buffers before any handler runs.
		#
		# 11MB because routers/jd.py's _MAX_JD_BYTES is 10 MB and its router
		# prefix is /jobs — a JD upload is a real document, and this block first
		# went in at 1MB, which would have 413'd every JD over a megabyte at the
		# edge (caught in review, 2026-10-06). Same +1MB multipart allowance as
		# the /offer* and /task* blocks above.
		request_body {
			max_size 11MB
		}
		reverse_proxy data_gateway:8002
	}
	handle /notifications* {
		reverse_proxy data_gateway:8002
	}
	handle /admin/* {
		reverse_proxy data_gateway:8002
	}
	handle /users/* {
		# Defence in depth only — it does NOT bound the parse (a kilobyte of
		# crafted PDF or xlsx is the real attack, see app/pdf_text.py). What it
		# does bound is the body FastAPI buffers before any handler runs. Sized
		# from the largest upload limit behind this prefix (review 2026-10-06).
		request_body {
			max_size 6MB
		}
		reverse_proxy data_gateway:8002
	}

	# ------------------------------------------------------------------
	# Catch-all health probe (used by uptime monitors). Proxies to
	# data_gateway's liveness endpoint — a 200 means at least one backend
	# is reachable; a 502 (data_gateway down) is the correct signal.
	# /health/deep is deliberately NOT exposed (it leaks dependency state).
	# ------------------------------------------------------------------
	handle /health {
		reverse_proxy data_gateway:8002 {
			rewrite /health/live
			transport http {
				dial_timeout 5s
				response_header_timeout 5s
			}
		}
	}

	# ------------------------------------------------------------------
	# Anything else that reached here is not a known API path — 404 so we
	# never accidentally serve an unmatched upstream.
	# ------------------------------------------------------------------
	handle {
		respond "Not Found" 404
	}

	# ------------------------------------------------------------------
	# Security headers on every response.
	# CSP/frame-ancestors: these are JSON API responses (the HTML origin is
	# on Vercel), so lock the API down to a non-renderable, non-framable
	# resource as defense-in-depth.
	# ------------------------------------------------------------------
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# ------------------------------------------------------------------
	# Logging — structured JSON for Loki scraping
	# ------------------------------------------------------------------
	# Access log — see space/Caddyfile for the full reasoning. Caddy redacts only
	# Cookie/Authorization; the exam, interview and draft-resume magic-link
	# tokens ride in custom headers and would otherwise be written verbatim to a
	# persistent sink, defeating the #fragment design that keeps them out of URLs.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>X-Exam-Token delete
				request>headers>X-Interview-Token delete
				request>headers>X-Draft-Token delete
				request>headers>X-Activation-Token delete
				request>headers>X-Offer-Token delete
				request>headers>X-Offer-Session delete
				request>headers>X-Task-Token delete
				request>headers>X-Test-Hooks-Token delete
				request>uri query {
					replace code REDACTED
					replace state REDACTED
					replace token REDACTED
				}
			}
		}
	}
}
