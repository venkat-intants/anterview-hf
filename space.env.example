# =============================================================================
# space.env — TEMPLATE (no real values) — fill from your own accounts.
#
#   *** SECRETS INSIDE — NEVER COMMIT THIS FILE. It is in .gitignore. ***
#
# Use: copy each line into the Hugging Face Space -> Settings -> Variables and
# secrets (keys with tokens/passwords/URLs as SECRETS, the rest as Variables).
# The container also boots from defaults for everything not listed here
# (see space/entrypoint.sh). Full instructions: HF-Deployment-Guide.docx.
#
# NOT carried over on purpose (the Space sets its own):
#   SERVICE_NAME / HOST / PORT       -> fixed by space/supervisord.conf
#   APP_ENV / DATABASE_SSL / POOL    -> production / require / 3 (entrypoint)
#   CORS / APP_BASE_URL / *_LINK_BASE_URL -> default to the Space URL
#   GOOGLE_OAUTH_REDIRECT_URI        -> must be re-registered for the Space URL
# =============================================================================

AUTH_PROVIDER=
AVATAR_PROVIDER=
CONSENT_IP_SALT=
DATABASE_URL=
EMAIL_FROM=
EMAIL_FROM_NAME=
# HF Spaces blocks outbound SMTP ports (25/465/587) — set EMAIL_PROVIDER=resend
# plus a Resend API key (https://resend.com) or candidate emails will queue but
# never deliver from the Space. SMTP_* below still serve local/VM deploys.
EMAIL_PROVIDER=
METRICS_TOKEN=
RESEND_API_KEY=
EXAM_LINK_SECRET=
EXECUTION_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
# Console copilots + candidate assessment panel. Default true; set false to
# disable the assistant without rotating GEMINI_API_KEY.
AGENTS_ENABLED=
# Nightly pipeline watchers -> in-app notifications. WATCHERS_CRON_HOUR is UTC.
WATCHERS_ENABLED=
WATCHERS_CRON_HOUR=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GROQ_API_KEY=
GROQ_MODEL=
INTERVIEW_LINK_SECRET=
JDOODLE_API_URL=
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
JWT_ALGORITHM=
JWT_AUDIENCE=
JWT_EXPIRY_HOURS=
JWT_ISSUER=
JWT_REFRESH_EXPIRY_DAYS=
JWT_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
LLM_PROVIDER=
PASSWORD_HASH_ROUNDS=
RATE_LIMIT_API_PER_MINUTE=
RATE_LIMIT_LOGIN_PER_MINUTE=
REDIS_SESSION_TTL_SECONDS=
REDIS_URL=
RETENTION_CRON_HOUR=
RETENTION_DAYS=
RETENTION_DRY_RUN=
S3_ACCESS_KEY_ID=
S3_BUCKET_AUDIO=
S3_BUCKET_DG=
S3_BUCKET_SCORECARDS=
S3_ENDPOINT=
S3_REGION=
S3_SECRET_ACCESS_KEY=
S3_USE_SSL=
SARVAM_API_KEY=
SARVAM_STT_MODEL=
SARVAM_TTS_MODEL=
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_USER=
SMTP_USE_TLS=
SPEECH_STT_PROVIDER=
SPEECH_TTS_PROVIDER=
TAVUS_API_KEY=
TAVUS_API_URL=
TAVUS_PERSONA_ID=
TAVUS_REPLICA_ID=

# ── Background poller cadence — a COST control on serverless Postgres ──────
# These all have code defaults; they are listed here because getting them
# wrong has already taken this Space down once, and the reason is not obvious.
#
# Neon's free plan bills COMPUTE HOURS and autosuspends an idle database after
# about five minutes. THE UNIT THAT COSTS MONEY IS A WAKE-UP, NOT A QUERY: one
# cheap SELECT keeps the compute alive for the whole suspend window, so a
# poller's cost is set by how OFTEN it runs, not by how much it does.
#
# That is easy to get wrong in the flattering direction. Raising the five
# intervals took the query count from ~19,400 a day to ~196 — 99x fewer —
# while taking compute only from ~24 h/day to ~16 h/day, because 196 wake-ups
# still blanket the day in five-minute windows. Any free allowance is still
# gone in a fortnight. Counting queries feels like progress and is not.
#
# So on a free tier the answer is to switch the optional loops OFF, not to
# slow them down. This profile is ~28 wake-ups a day, ~2 h/day of compute,
# ~70 compute-hours a month.
#
# WHAT EACH ONE COSTS, so this is a choice rather than a default:
#   EMAIL_OUTBOX_ENABLED=false   — queued mail is NOT sent. Rows still queue
#       and send when re-enabled. Cheap today only because Resend is still
#       sandboxed to one verified address; turn this back ON the moment a
#       sending domain is verified, or set-password links silently never
#       arrive.
#   REMINDERS_ENABLED=false      — deadline reminder emails do not go out.
#   RECONCILIATION_ENABLED=false — a failed CV upload or embedding does not
#       self-heal; it stays failed until this is re-enabled.
#   WATCHERS_ENABLED=false       — nightly agent watchers do not run.
# Scheduled publishing has no off switch and is capped at 3600 s, so an
# opening set to publish at 09:00 goes live by about 10:00.
#
# ON A PAID PLAN OR AN ALWAYS-ON POSTGRES (the Tier-2 AWS RDS target), DELETE
# THIS WHOLE BLOCK. None of it applies and every line degrades the product.
EMAIL_OUTBOX_ENABLED=false
REMINDERS_ENABLED=false
RECONCILIATION_ENABLED=false
WATCHERS_ENABLED=false
SCHEDULED_PUBLISH_INTERVAL_SECONDS=3600
ERASURE_POLL_INTERVAL_SECONDS=21600
EMAIL_POLL_INTERVAL_SECONDS=3600
