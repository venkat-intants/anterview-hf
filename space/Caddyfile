# =============================================================================
# Caddyfile — HF Space edition (single container, one public port).
#
# Hugging Face terminates TLS and forwards to :7860, so this listener is plain
# HTTP. It does two jobs:
#   1. serve the built React SPA from /app/webdist (same origin as the APIs —
#      the frontend was built with empty VITE_*_API_URL bases)
#   2. fan out API paths to the four loopback services, mirroring the
#      production routing contract in the repo-root Caddyfile. Keep the two in
#      sync when routes change. Longest-path-wins disambiguates the shared
#      /admin/*, /api/* and /users/* prefixes.
# =============================================================================
{
	auto_https off
	admin off
	servers {
		# This list decides whether the inbound X-Forwarded-For survives.
		# Caddy preserves the chain and appends its peer only when that peer
		# is trusted; from an untrusted peer it REPLACES the whole header with
		# the peer address, which erases the candidate's IP and leaves the
		# backends' TRUSTED_PROXY_COUNT arithmetic (see space/entrypoint.sh)
		# with nothing to count. HF terminates TLS at its edge and forwards
		# over the internal cluster network, so that peer is normally an
		# RFC1918 address already covered by private_ranges. If a Space is
		# ever fronted by a proxy on a public address, put its CIDR in
		# SPACE_EXTRA_TRUSTED_PROXIES — the access log below reports the peer
		# as `request.remote_ip`, so verify it rather than guessing. Never
		# widen this to 0.0.0.0/0: every entry here is an address permitted to
		# assert who the client is.
		trusted_proxies static private_ranges {$SPACE_EXTRA_TRUSTED_PROXIES}
	}
}

:7860 {
	# -- SPA-first navigation ---------------------------------------------
	# The React app owns EVERY browser page load. A navigation is
	# GET + Accept: text/html; the APIs are JSON-only and PDFs/exports are
	# pre-signed R2 or blob: URLs, so the ONLY backend endpoints a browser
	# navigates to are the OAuth redirects under /auth/sso/* (excluded).
	# Without this, every SPA route that shares a prefix with a proxied API
	# (/hr/*, /admin/*, /exam, /interview-invite, /jobs, ...) returns raw
	# JSON in any browser without the PWA service worker installed.
	# `rewrite` runs before all `handle` blocks (Caddy directive order), so
	# navigations become /index.html and fall through to the SPA catch-all.
	# /health is excluded for the same reason: uptime monitors and browsers
	# send Accept: text/html, and without the exclusion the probe was rewritten
	# to /index.html and answered 200 by the static file server — green while
	# data_gateway was dead.
	@spa_nav {
		method GET
		header Accept *text/html*
		not path /auth/sso/* /internal/* /metrics* /health
	}
	rewrite @spa_nav /index.html

	# -- Never expose internal-only or metrics endpoints ------------------
	handle /internal/* {
		respond "Forbidden" 403
	}
	handle /metrics* {
		respond "Forbidden" 403
	}
	# /test-hooks/* runs data_gateway's background passes on demand for the
	# local browser tests. The router is only mounted when TEST_HOOKS_ENABLED,
	# and config refuses that flag outside a local env — this is the second,
	# independent lock: even a mis-set env cannot make it reachable from
	# outside. 404, not 403: a deployment has no test surface to admit to.
	handle /test-hooks* {
		respond "Not Found" 404
	}

	# -- admin_ops :8004 (more-specific /admin + /users subpaths) ---------
	handle /admin/analytics/* {
		reverse_proxy 127.0.0.1:8004
	}
	handle /admin/interviews* {
		reverse_proxy 127.0.0.1:8004
	}
	handle /admin/overview* {
		reverse_proxy 127.0.0.1:8004
	}
	handle /admin/status* {
		reverse_proxy 127.0.0.1:8004
	}
	handle /admin/system/* {
		reverse_proxy 127.0.0.1:8004
	}
	handle /users/*/dpdp/* {
		reverse_proxy 127.0.0.1:8004
	}

	# -- feedback_billing :8003 -------------------------------------------
	handle /api/scorecards* {
		reverse_proxy 127.0.0.1:8003
	}

	# -- interview_core :8001 ----------------------------------------------
	handle /api/* {
		reverse_proxy 127.0.0.1:8001
	}
	handle /ws/* {
		reverse_proxy 127.0.0.1:8001
	}

	# -- data_gateway :8002 (auth, ATS, exams, consent + generic catch-alls)
	# /apply* and /careers* are the PUBLIC candidate surface (PH3): the careers
	# board, the application form, the activation links and all six Save & Resume
	# draft routes. They were missing from both Caddyfiles from the day the
	# routers landed, so every one of them bypassed data_gateway entirely — on the
	# Space an XHR fell through to `try_files {path} /index.html` and came back as
	# index.html with HTTP 200, so `res.ok` was true and res.json() threw on the
	# HTML. A dead feature that reports success is the expensive kind.
	#
	# Browser NAVIGATION to /apply/:id, /apply/draft and /careers/:slug is still
	# the SPA's — the @spa_nav rewrite above runs before every handle block, which
	# is the same mechanism that lets /hr/*, /jobs* and /exam* be both a React
	# route and an API prefix. Only XHR (Accept: */*) reaches the backend.
	handle /apply* {
		# ANONYMOUS, AND THE ONLY UPLOAD ON THIS PREFIX IS A 5 MB CV.
		#
		# Sized from the handler's own limit, not guessed. A cap here is the ONLY
		# control that works: fastapi 0.133 reads the whole request body before it
		# solves a route's dependencies, so the in-handler size check and the
		# rate_limit both run AFTER an arbitrarily large body has been buffered —
		# a multipart file part lands in a SpooledTemporaryFile that rolls onto
		# this container's disk. Pre-auth, pre-limit, one request (VAPT 2026-10-05).
		#
		# `_MAX_RESUME_BYTES` is therefore a bound on what the handler READS, not
		# on what the service RECEIVES. docs/ACCEPTED-RISKS.md AR-10 residue 3
		# recorded that the rate limits "never reach the upload at all"; this is
		# the bound that does.
		#
		# 6MB, not the 8MB PH3-B4b first put here: 5 MB of CV plus multipart
		# overhead, with the JSON answers field and the form text accounted for
		# rather than given room to spare. The VAPT number is the one kept — it
		# is derived from the same handler limit and is tighter.
		request_body {
			max_size 6MB
		}
		reverse_proxy 127.0.0.1:8002
	}
	handle /careers* {
		# Sized from the handler's own limit, not guessed. A cap here is the ONLY
		# control that works: fastapi 0.133 reads the whole request body before it
		# solves a route's dependencies, so the in-handler size check and the
		# rate_limit both run AFTER an arbitrarily large body has been buffered —
		# a multipart file part lands in a SpooledTemporaryFile that rolls onto
		# this container's disk. Pre-auth, pre-limit, one request (VAPT 2026-10-05).
		request_body {
			max_size 256KB
		}
		reverse_proxy 127.0.0.1:8002
	}
	handle /agent/* {
		reverse_proxy 127.0.0.1:8002
	}
	# /interviewer/* — PH4-A1's interviewer console API. Browser navigation to
	# the /interviewer SPA route is still the SPA's via @spa_nav above.
	handle /interviewer/* {
		# JSON only — scorecards, notes (20 000 characters at most) — and no
		# uploads, so a megabyte is generous. Set here rather than on /hr/*,
		# which carries bulk CV uploads of up to 250 MB.
		request_body {
			max_size 1MB
		}
		reverse_proxy 127.0.0.1:8002
	}
	handle /auth/* {
		# Sized from the handler's own limit, not guessed. A cap here is the ONLY
		# control that works: fastapi 0.133 reads the whole request body before it
		# solves a route's dependencies, so the in-handler size check and the
		# rate_limit both run AFTER an arbitrarily large body has been buffered —
		# a multipart file part lands in a SpooledTemporaryFile that rolls onto
		# this container's disk. Pre-auth, pre-limit, one request (VAPT 2026-10-05).
		request_body {
			max_size 256KB
		}
		reverse_proxy 127.0.0.1:8002
	}
	handle /consent* {
		reverse_proxy 127.0.0.1:8002
	}
	handle /exam* {
		# Sized from the handler's own limit, not guessed. A cap here is the ONLY
		# control that works: fastapi 0.133 reads the whole request body before it
		# solves a route's dependencies, so the in-handler size check and the
		# rate_limit both run AFTER an arbitrarily large body has been buffered —
		# a multipart file part lands in a SpooledTemporaryFile that rolls onto
		# this container's disk. Pre-auth, pre-limit, one request (VAPT 2026-10-05).
		request_body {
			max_size 2MB
		}
		reverse_proxy 127.0.0.1:8002
	}
	# /hr/rounds/*/task/materials* — PH4-D4: HR's reference-material upload,
	# capped like the repo-root Caddyfile (more specific than /hr/* below,
	# which must stay uncapped for bulk CV ingestion). L8, security review
	# PH4-D4 wave 5 — docs/ACCEPTED-RISKS.md AR-6 claimed this was already
	# true.
	handle /hr/rounds/*/task/materials* {
		request_body {
			max_size 11MB
		}
		reverse_proxy 127.0.0.1:8002
	}
	# /hr/applicants/bulk — the ONE route behind /hr/* that is meant to carry a
	# large body: up to _MAX_BULK_FILES (500) resumes and _MAX_BULK_TOTAL_BYTES
	# (250 MB) in a single multipart request, both enforced in the handler. A
	# tighter prefix cap would 413 a legitimate batch at the edge, which is why
	# this needs its own block rather than a bigger number on /hr/* (review
	# 2026-10-06). Longest-path-wins puts it ahead of /hr/* — see the header.
	handle /hr/applicants/bulk* {
		request_body {
			max_size 260MB
		}
		reverse_proxy 127.0.0.1:8002
	}
	handle /hr/* {
		# Defence in depth only — it does NOT bound the parse (a kilobyte of
		# crafted PDF or xlsx is the real attack, see app/pdf_text.py). What it
		# does bound is the body FastAPI buffers before any handler runs.
		#
		# 12MB is the largest single-document limit behind this prefix: the HR
		# library corpus and preboarding documents are 10 MB
		# (corpus_document_max_bytes, preboarding_document_max_bytes), the exam
		# and question-bank importers 2 MB, a single resume 5 MB. The two routes
		# that legitimately exceed it have their own blocks above —
		# /hr/rounds/*/task/materials* and /hr/applicants/bulk*.
		request_body {
			max_size 12MB
		}
		reverse_proxy 127.0.0.1:8002
	}
	handle /interview-invite* {
		# Sized from the handler's own limit, not guessed. A cap here is the ONLY
		# control that works: fastapi 0.133 reads the whole request body before it
		# solves a route's dependencies, so the in-handler size check and the
		# rate_limit both run AFTER an arbitrarily large body has been buffered —
		# a multipart file part lands in a SpooledTemporaryFile that rolls onto
		# this container's disk. Pre-auth, pre-limit, one request (VAPT 2026-10-05).
		request_body {
			max_size 256KB
		}
		reverse_proxy 127.0.0.1:8002
	}
	# PH4-A3/A4 — the candidate's offer and preboarding documents (X-Offer-Token).
	handle /offer* {
		request_body {
			max_size 11MB
		}
		reverse_proxy 127.0.0.1:8002
	}
	# PH4-D4 — a job-simulation or portfolio task (X-Task-Token).
	handle /task* {
		request_body {
			max_size 11MB
		}
		reverse_proxy 127.0.0.1:8002
	}
	handle /jobs* {
		# Defence in depth only — it does NOT bound the parse (a kilobyte of
		# crafted PDF is the real attack, see app/pdf_text.py). What it does bound
		# is the body FastAPI buffers before any handler runs.
		#
		# 11MB because routers/jd.py's _MAX_JD_BYTES is 10 MB and its router
		# prefix is /jobs — a JD upload is a real document, and this block first
		# went in at 1MB, which would have 413'd every JD over a megabyte at the
		# edge (caught in review, 2026-10-06). Same +1MB multipart allowance as
		# the /offer* and /task* blocks above.
		request_body {
			max_size 11MB
		}
		reverse_proxy 127.0.0.1:8002
	}
	handle /notifications* {
		reverse_proxy 127.0.0.1:8002
	}
	handle /admin/* {
		reverse_proxy 127.0.0.1:8002
	}
	handle /users/* {
		# Defence in depth only — it does NOT bound the parse (a kilobyte of
		# crafted PDF or xlsx is the real attack, see app/pdf_text.py). What it
		# does bound is the body FastAPI buffers before any handler runs. Sized
		# from the largest upload limit behind this prefix (review 2026-10-06).
		request_body {
			max_size 6MB
		}
		reverse_proxy 127.0.0.1:8002
	}

	# -- health probe (uptime monitors; also what keeps the Space "active")
	handle /health {
		reverse_proxy 127.0.0.1:8002 {
			rewrite /health/live
		}
	}

	# -- everything else: the React SPA (client-side routing fallback) -----
	handle {
		root * /app/webdist
		try_files {path} /index.html
		file_server
	}

	# Security headers.
	#
	# This origin serves the HTML, unlike the repo-root Caddyfile whose origin
	# is JSON-only — so the root's `default-src 'none'` CSP and its
	# `Permissions-Policy: microphone=(), camera=()` must NOT be copied here.
	# The first would blank the SPA; the second would kill the interview, which
	# is the entire product. What DOES transfer is the anti-framing pair, and
	# it was missing: the live app could be embedded in a hostile page and
	# clickjacked.
	#
	# It must NOT be 'none', and X-Frame-Options must NOT be set at all:
	# Hugging Face serves a Space by embedding this origin in an iframe on
	# huggingface.co, and that page is the canonical URL for the product (this
	# origin returns `link: <...>; rel="canonical"` pointing at it). Denying
	# framing outright renders the Space page a blank frame in every browser —
	# a silent, console-only failure that a candidate discovers, not a health
	# check. X-Frame-Options has no allow-list form for a third-party origin,
	# so it cannot express "huggingface.co only" and has to go; CSP
	# frame-ancestors supersedes it in every browser that matters.
	#
	# 'self' keeps the app embeddable by itself; huggingface.co is the one
	# third-party embedder that must work. Everything else is still blocked, so
	# the clickjacking protection the API origin has is preserved here in the
	# only form this deployment can actually use.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "frame-ancestors 'self' https://huggingface.co"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Access log — with the bearer-equivalent credentials filtered OUT.
	#
	# Caddy auto-redacts only Cookie/Set-Cookie/Authorization/Proxy-Authorization.
	# This app carries three credentials in CUSTOM headers, which are logged
	# verbatim without this block:
	#   X-Exam-Token      (web/src/api/publicExam.ts)      — 72h TTL
	#   X-Interview-Token (web/src/api/publicInterview.ts) — 48h TTL, and it
	#                     redeems to a full candidate session plus PII
	# That would undo the deliberate #fragment design: the token is kept out of
	# the URL precisely so it never reaches a server log, and then the header
	# put it there anyway at the last hop.
	#
	# The query filter covers the one credential-bearing query string that does
	# exist — the OAuth callback's ?code=&state= — since every other token in
	# this app travels in the fragment.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>X-Exam-Token delete
				request>headers>X-Interview-Token delete
				request>headers>X-Draft-Token delete
				request>headers>X-Activation-Token delete
				request>headers>X-Offer-Token delete
				request>headers>X-Offer-Session delete
				request>headers>X-Task-Token delete
				request>headers>X-Test-Hooks-Token delete
				request>uri query {
					replace code REDACTED
					replace state REDACTED
					replace token REDACTED
				}
			}
		}
	}
}
